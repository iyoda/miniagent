# Copy this file to .env and fill in your key, then `export $(cat .env | xargs)`
# or just `export OPENAI_API_KEY=...` in your shell.
# Note: miniagent reads os.environ directly; it does NOT auto-load .env.
OPENAI_API_KEY=sk-...

# Optional: override the default model (gpt-5.4-mini)
# MODEL=gpt-5.4-mini
